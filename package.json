    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@types/node": "22.15.30",
    "@vue/runtime-core": "3.4.21",
    "adm-zip": "0.5.16",
    "tsx": "4.20.3",
    "typescript": "5.6.3",
    "vite": "5.2.8",
    "vue-tsc": "2.2.12"
