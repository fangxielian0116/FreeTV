    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "htmlparser2": "10.0.0",
    "js-spatial-navigation": "1.0.1",
    "opencc-js": "1.4.2",
    "pinyin-pro": "3.29.5",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
