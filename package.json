    "pack:android": "node scripts/pack-android-offline.mjs phone",
    "pack:offline": "node scripts/pack-android-offline.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build:h5 && npm run build:android",
    "doctor": "node scripts/doctor.mjs",
    "prepare:native": "node scripts/prepare-native-check.mjs",
    "build:tv": "node scripts/build-tv.mjs",
    "build:tv:h5": "node scripts/build-tv.mjs --h5",
